#!/usr/bin/env bash
# Symlink the dotfiles into $HOME with GNU stow. Picks packages by OS.
set -euo pipefail

cd "$(dirname "$0")/.."

common=(apps atuin bat claude git local yazi)
linux=(hypr)
macos=(asimov ghostty flashspace mise nvim raycast zsh)

packages=("${common[@]}")
case "$(uname -s)" in
  Darwin) packages+=("${macos[@]}") ;;
  *)      packages+=("${linux[@]}") ;;
esac

for pkg in "${packages[@]}"; do
  echo "stow --ignore=DS_Store -t $HOME $pkg"
  stow --ignore=DS_Store -t "$HOME" "$pkg"
done
